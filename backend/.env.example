# ============================================
# EduGenie Backend Environment Variables
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/edugenie
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/edugenie

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_from_aistudio.google.com
GEMINI_MODEL=gemini-2.0-flash

# CORS - Frontend URL
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
